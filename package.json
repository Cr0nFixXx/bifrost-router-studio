{
  "name": "bifrost-router-studio",
  "private": true,
  "version": "0.2.8",
  "type": "module",
  "description": "Client-side SQLite editor & visual planner for Bifrost AI Gateway routing rules. No backend — uses sql.js (WASM SQLite) to read/write the Bifrost DB file directly in the browser.",
  "scripts": {
    "dev": "npm run copy-wasm && vite",
    "build": "npm run copy-wasm && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "copy-wasm": "node scripts/copy-wasm.mjs",
    "bridge": "node scripts/local-bridge.mjs",
    "dev:bridge": "node scripts/local-bridge.mjs"
  },
  "dependencies": {
    "fast-xml-parser": "^5.9.3",
    "framer-motion": "^11.5.4",
    "lucide-react": "^0.445.0",
    "nanoid": "^5.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4",
    "sql.js": "^1.12.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.6.2",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "build": "26080521",
  "license": "AGPL-3.0-only"
}

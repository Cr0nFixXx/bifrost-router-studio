# Server configuration
PORT=8787
# Path to the live Bifrost SQLite DB (optional). Leave unset to use the bundled local DB.
BIFROST_DB_PATH=./data/bifrost.db

# --- API mode: sync rules against a running Bifrost gateway ---------------
# Read by scripts/local-bridge.mjs only. Never bundled into the frontend.
BFRS_BIFROST_URL=http://localhost:8080
# Management token for the gateway's /api/* management API. Alternative:
# BFRS_BIFROST_USER=<admin> + BFRS_BIFROST_PASSWORD=<pw> (base64-encoded by the bridge).
BFRS_BIFROST_TOKEN=
